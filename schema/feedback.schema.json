{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archeyes.dev/schema/feedback.json",
  "title": "Feedback",
  "description": "The structured diff the UI emits on SEND/APPROVE/CANCEL. Printed verbatim to the CLI's stdout (and nothing else) so the agent can parse it. Every entry carries node/edge IDs — no prose disambiguation needed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["revise", "approve", "cancel"],
      "description": "revise = apply edits and re-render · approve = apply pending edits as final touch-ups, loop ends · cancel = agent stops the loop, keeps plan as-is"
    },
    "comments": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "text"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "description": "May contain @NodeId mentions" }
        }
      }
    },
    "edgeComments": {
      "type": "array",
      "default": [],
      "description": "Feedback the developer left on a connection (via the edge inspector). Edge-scoped counterpart of comments[]; kept separate so the agent reads a dedicated edge stream.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "text"],
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "description": "May contain @NodeId mentions" }
        }
      }
    },
    "reconnected": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "end", "was", "now"],
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "enum": ["source", "target"], "description": "Which endpoint the dev re-dragged" },
          "was": { "type": "string", "minLength": 1, "description": "Node id the endpoint pointed at before" },
          "now": { "type": "string", "minLength": 1, "description": "Node id the endpoint points at now" }
        }
      }
    },
    "deleted": {
      "type": "object",
      "additionalProperties": false,
      "default": { "nodes": [], "edges": [] },
      "properties": {
        "nodes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "edges": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "added": {
      "type": "object",
      "additionalProperties": false,
      "default": { "edges": [] },
      "description": "New nodes and/or edges the developer drew on the canvas. A new node carries a client-side tempId (e.g. 'new:1'); added edges may reference that tempId as an endpoint. The agent creates each node, assigns a real id, wires the edges, and echoes the tempId → real-id mapping back so the next render shows the real name.",
      "properties": {
        "nodes": {
          "type": "array",
          "default": [],
          "description": "Nodes the dev created this round. tempId is dev-side only; the agent replaces it with a real node id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tempId", "label", "kind"],
            "properties": {
              "tempId": { "type": "string", "minLength": 1, "description": "Client-side placeholder id (e.g. 'new:1'). Referenced by added.edges until the agent assigns a real id." },
              "label": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": ["service", "repository", "datastore", "adapter", "external", "module", "component", "other"],
                "description": "Same kind vocabulary as plan-graph nodes; drives the node icon."
              },
              "group": { "type": "string", "description": "Optional target group id (references graph.groups[].id)" },
              "description": { "type": "string", "description": "Optional free-text intent for the new node" }
            }
          }
        },
        "edges": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "minLength": 1, "description": "Source node id, or an added-node tempId" },
              "to": { "type": "string", "minLength": 1, "description": "Target node id, or an added-node tempId" },
              "kind": { "type": "string" }
            }
          }
        }
      }
    },
    "moved": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "toGroup"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "toGroup": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generalNote": { "type": "string", "description": "Free-text feedback that isn't node-specific" }
  }
}
