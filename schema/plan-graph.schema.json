{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archeyes.dev/schema/plan-graph.json",
  "title": "PlanGraph",
  "description": "The architecture graph the agent authors from a plan, spec, or codebase. status ∈ {existing,new,modify,delete} on nodes AND edges powers the before/after diff rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["existing", "new", "modify", "delete"],
      "description": "existing = unchanged · new = added by this plan · modify = touched · delete = removed"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identity across rounds. The agent MUST reuse this ID when revising, or comments/layout keyed to it are lost."
        },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["service", "repository", "datastore", "adapter", "external", "module", "component", "other"],
          "description": "Drives the node icon (lucide). service=box, repository=archive, datastore=database, adapter=plug, external=globe."
        },
        "group": { "type": "string", "description": "References a groups[].id" },
        "status": { "$ref": "#/definitions/status" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "description": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1, "description": "Source node id" },
        "to": { "type": "string", "minLength": 1, "description": "Target node id" },
        "kind": {
          "type": "string",
          "description": "Relationship label rendered on the edge, e.g. calls, reads, writes, depends",
          "default": "calls"
        },
        "status": { "$ref": "#/definitions/status" }
      }
    }
  }
}
